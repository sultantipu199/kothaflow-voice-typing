<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="KothaFlow Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="KothaFlow Studio"
                android:textColor="#F8FAFC"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Wispr Flow স্টাইল ভাসমান ভয়েস টাইপিং ও স্মার্ট কিবোর্ড"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- CARD 1: Floating Bubble Hero Feature -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔮 ভাসমান ভয়েস বাবল (Wispr Flow)"
                    android:textColor="#38BDF8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBubbleStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_secondary"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="অফলাইন"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="আপনার ফোনের ডিফল্ট Google কিবোর্ড (Gboard) চালু রেখেই স্ক্রিনের পাশে থাকা ছোট বাবলে ১-ট্যাপ করে ভয়েস টাইপ করুন!"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnToggleBubble"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_primary"
                android:text="✨ ভাসমান বাবল চালু করুন"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- CARD 2: Accessibility Auto-Type Permission -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ স্বয়ংক্রিয় টাইপিং সার্ভিস (Auto-Type)"
                    android:textColor="#10B981"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAccessStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_secondary"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="চেক করা হচ্ছে"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Messenger, WhatsApp বা যেকোনো চ্যাটে কথা বললে যাতে নিজে নিজে মেসেজ বক্সে লেখা বসে যায়, তার জন্য এটি প্রয়োজন।"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnEnableAccessibility"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="অ্যাক্সেসিবিলিটি অনুমতি দিন (অন করুন)"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- CARD 3: Voice Test Lab -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ ভয়েস টাইপিং টেস্ট বক্স:"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etTestInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="top|start"
                android:hint="এখানে ক্লিক করে ভাসমান বাবল পরীক্ষা করুন অথবা নিচের মাইকে কথা বলুন..."
                android:padding="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginTop="14dp">

                <ImageButton
                    android:id="@+id/btnTestMic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_btn_mic"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:contentDescription="ভয়েস টেস্ট" />

                <TextView
                    android:id="@+id/tvMicStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="মাইক চেপে কথা বলুন (বাংলা বা ইংরেজি)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 4: Optional Virtual Keyboard Setup -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌨️ ফুল-স্ক্রিন কিবোর্ড মোড (ঐচ্ছিক):"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="আপনি যদি ভাসমান বাবলের বদলে সরাসরি অন-স্ক্রিন কিবোর্ড হিসেবে KothaFlow ব্যবহার করতে চান:"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnEnableKeyboard"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="কীবোর্ড সেটিংস খুলুন"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSelectKeyboard"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="ডিফল্ট কিবোর্ড নির্বাচন করুন"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
