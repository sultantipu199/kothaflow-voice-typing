<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvKbLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_secondary"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="🇧🇩 বাংলা"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKbStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="KothaFlow ভয়েস কিবোর্ড"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSwitchKb"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_secondary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⌨️ কিবোর্ড বদলান"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Center Big Mic Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnKbMic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_btn_mic"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="কথা বলতে চাপুন" />

        <TextView
            android:id="@+id/tvKbPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="মাইক চেপে কথা বলুন..."
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Key Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnKeyComma"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_secondary"
            android:text=","
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnKeyDari"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="।"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnKeyQuestion"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="?"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnKeySpace"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:text="Space / স্পেস"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnKeyBackspace"
            android:layout_width="54dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="⌫"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnKeyEnter"
            android:layout_width="54dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_primary"
            android:text="↵"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
