{
  "name": "kothaflow-desktop",
  "version": "1.0.8",
  "description": "KothaFlow Desktop Voice Typing (Wispr Flow Style Floating Bubble)",
  "main": "electron-main.cjs",
  "author": "KothaFlow",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kothaflow.studio",
    "productName": "KothaFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.cjs",
      "overlay.html",
      "paste.vbs",
      "avatar.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    }
  }
}
