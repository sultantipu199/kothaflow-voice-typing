{
  "name": "kothaflow-desktop",
  "version": "1.2.2",
  "description": "KothaFlow Desktop Voice Typing (Wispr Flow Style Floating Bubble)",
  "main": "electron-main.cjs",
  "author": "KothaFlow",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kothaflow.studio",
    "productName": "KothaFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.cjs",
      "auto-healer.cjs",
      "overlay.html",
      "paste.vbs",
      "paste.exe",
      "avatar.png",
      "icon.ico",
      "groq_key.txt"
    ],
    "asarUnpack": [
      "paste.exe"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "KothaFlow"
    }
  }
}
